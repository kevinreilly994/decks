DJANGO_SECRET_KEY=change-me-to-a-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Omit DATABASE_URL in dev to use SQLite. For Postgres:
# DATABASE_URL=postgres://decks:decks@localhost:5432/decks

# --- Phase 3: live providers (leave blank to skip that provider in sync) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
BANDSINTOWN_APP_ID=
# DECKS_SYNC_PROVIDERS=spotify,bandsintown

# --- Object storage for uploaded headshots (prod; blank = local disk) ---
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set AWS_S3_ENDPOINT_URL for Cloudflare R2 / Backblaze B2 (omit for AWS S3):
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
# AWS_S3_CUSTOM_DOMAIN=media.yourdomain.com
